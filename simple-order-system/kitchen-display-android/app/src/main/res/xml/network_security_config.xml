<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud (order.fwv-raura.ch) nur ueber HTTPS. Der Vor-Ort-Server im Festzelt
    (Raspberry Pi, kasse.local) spricht nur HTTP — ohne diese Ausnahme blockt
    Android ab targetSdk 28 jede Anfrage dorthin, und die automatische
    Erkennung des Vor-Ort-Servers schlug immer fehl.
-->
<network-security-config>
    <!-- Kasse vor Ort (T400, Oktober 2026): Let's-Encrypt-Kette ECC (YE1 ->
         Root YE -> ISRG Root X2). Android 7.1 kennt X1, aber nicht X2; die
         beiden Wurzeln liegen deshalb zusaetzlich zu den System-CAs bei. -->
    <domain-config>
        <domain includeSubdomains="false">kasse-lokal.fwv-raura.ch</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">kasse.local</domain>
    </domain-config>
</network-security-config>
