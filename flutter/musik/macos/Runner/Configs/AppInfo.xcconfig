// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = FWV Musik

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = ch.fwvraura.musik

// Test-Builds (flutter run / build --debug) heissen anders und haben eine
// eigene Kennung: sonst zeigt macOS zwei "FWV Musik", nimmt womoeglich den
// unsignierten Test-Build und fragt wieder nach dem Schluesselbund-Passwort.
PRODUCT_NAME[config=Debug] = FWV Musik Test
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = ch.fwvraura.musik.test

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Feuerwehrverein Raura
